#!/bin/sh
# Fenix one-command launcher (POSIX sh).
set -eu
cd "$(dirname "$0")"

# Git Bash (MSYS) rewrites /opt/... arguments into Windows paths before they
# reach docker.exe; container paths must pass through untouched. No-op elsewhere.
export MSYS_NO_PATHCONV=1 MSYS2_ARG_CONV_EXCL='*'

PORT="${FENIX_PORT:-4600}"
API_SERVICE="fenix-api"
ENTRYPOINT="/opt/fenix/docker/entrypoint.sh"
SECRET_DIR=".fenix/secrets"
ENV_FILE=".fenix/fenix.env"

usage() {
  cat <<'EOF'
Fenix launcher.

Usage: fenix [command]

  up               preflight, set up missing keys, build and start the stack
  stop             stop the stack
  down             stop and remove containers (the data volume is kept)
  logs [service]   follow logs (default: all services)
  doctor           host preflight plus in-container diagnostics
  retention [show|apply|prune] [--dry-run]
                   inspect or change log retention (default: show)
  keys [name]      run the key wizard (no argument) or rotate one key:
                   openrouter | provider | linear | github
  attach [--new]   open the Supervisor (Ctrl-b d detaches; it keeps running in the container)
  shell [service]  open a shell in a service (default: fenix-supervisor)
  repo add <url|owner/name> [--project <Linear project>]
                   clone a repository into the workspaces volume (optionally map a Linear project)
  repo list        repositories in the workspaces volume and the project map
  update           git pull --ff-only, rebuild with fresh base images, restart
  test [args]      lint and the full test suite on Linux, inside the image

Exit codes: 0 ok | 2 usage | 3 preflight failed | 4 health timeout | 5 key rejected
EOF
}

# --- host uid for the image build (FOC-803) ----------------------------------

# On a Linux host the image is built for the invoking user's uid/gid, so the
# bind-mounted host files (.fenix/secrets, .fenix/config) stay readable and
# writable inside the container. Docker Desktop (macOS/Windows) maps file
# ownership itself — leave the variables unset there. As root, warn and keep
# the default uid 1000: the container never runs as root.
set_build_uid() {
  case "$(uname -s)" in
    Linux) ;;
    *) return 0 ;;
  esac
  if [ -n "${FENIX_UID:-}" ] || [ -n "${FENIX_GID:-}" ]; then
    return 0
  fi
  if [ "$(id -u)" = "0" ]; then
    printf 'WARN running fenix as root: the container keeps uid 1000; run fenix as your normal user\n'
    return 0
  fi
  FENIX_UID="$(id -u)"
  FENIX_GID="$(id -g)"
  export FENIX_UID FENIX_GID
}
set_build_uid

# --- preflight ---------------------------------------------------------------

pf_ok()        { printf 'OK  %s\n' "$1"; }
pf_fail_line() { printf 'FAIL %s — %s — fix: %s\n' "$1" "$2" "$3"; }
pf_warn()      { printf 'WARN %s — %s\n' "$1" "$2"; }

preflight() {
  # $1 = strict (first FAIL exits 3) | full (report every check, return 1 on any FAIL)
  mode="$1"
  pf_fail=0

  # FOC-803: which uid/gid the image build targets (Linux only — Docker
  # Desktop maps file ownership itself, so the line stays silent there).
  case "$(uname -s)" in
    Linux)
      pf_ok "host uid for the image build: ${FENIX_UID:-1000}:${FENIX_GID:-1000}"
      ;;
  esac

  if command -v docker >/dev/null 2>&1; then
    pf_ok "docker on PATH"
  else
    pf_fail_line "docker" "docker not found on PATH" "install Docker Desktop (or add docker to PATH)"
    if [ "$mode" = "strict" ]; then exit 3; fi
    pf_fail=$((pf_fail + 1))
  fi

  if docker info >/dev/null 2>&1; then
    pf_ok "docker daemon running"
  else
    pf_fail_line "docker daemon" "cannot reach the Docker daemon" "start Docker Desktop and wait until it is running"
    if [ "$mode" = "strict" ]; then exit 3; fi
    pf_fail=$((pf_fail + 1))
  fi

  if docker compose version >/dev/null 2>&1; then
    pf_ok "docker compose available"
  else
    pf_fail_line "docker compose" "compose plugin not available" "update Docker (the compose plugin ships with it)"
    if [ "$mode" = "strict" ]; then exit 3; fi
    pf_fail=$((pf_fail + 1))
  fi

  # Free disk >= 10 GB in the repo directory (WARN, not FAIL, if df fails).
  avail_kb=$(df -Pk . 2>/dev/null | awk 'NR == 2 { print $4 }')
  if [ -n "$avail_kb" ]; then
    if awk -v a="$avail_kb" 'BEGIN { exit !(a >= 10485760) }'; then
      pf_ok "free disk >= 10 GB"
    else
      pf_fail_line "free disk" "$(awk -v a="$avail_kb" 'BEGIN { printf "%.1f", a / 1048576 }') GB free (need 10 GB)" "free up disk space"
      if [ "$mode" = "strict" ]; then exit 3; fi
      pf_fail=$((pf_fail + 1))
    fi
  else
    pf_warn "free disk" "could not read free space (df failed) — continuing"
  fi

  # Docker memory >= 4 GB (WARN, not FAIL, if lower or unreadable).
  mem=$(docker info --format '{{.MemTotal}}' 2>/dev/null) || mem=""
  if [ -n "$mem" ]; then
    if awk -v m="$mem" 'BEGIN { exit !(m >= 4294967296) }'; then
      pf_ok "docker memory >= 4 GB"
    else
      pf_warn "docker memory" "$(awk -v m="$mem" 'BEGIN { printf "%.1f", m / 1073741824 }') GB — below 4 GB, the build may fail"
    fi
  else
    pf_warn "docker memory" "could not read MemTotal from docker info — continuing"
  fi

  if [ "$pf_fail" -gt 0 ]; then
    return 1
  fi
  return 0
}

# --- key wizard --------------------------------------------------------------

restore_tty() {
  stty echo 2>/dev/null || true
}

read_secret() {
  # $1 = prompt text; result in REPLY_SECRET (never echoed).
  k=""
  printf '%s' "$1"
  if [ -t 0 ]; then
    stty -echo 2>/dev/null || true
  fi
  IFS= read -r k || true
  if [ -t 0 ]; then
    stty echo 2>/dev/null || true
  fi
  printf '\n'
  REPLY_SECRET="$k"
}

in_container_node() {
  # Run `node <script>` inside the fenix-api image (repo baked at /opt/fenix).
  # stdin passes through, so keys travel ONLY via stdin — never argv/env of a
  # docker command line. Builds the image first when it is missing.
  script="$1"
  shift
  if ! docker image inspect fenix:dev >/dev/null 2>&1; then
    printf 'Building the image first...\n'
    docker compose build fenix-api
  fi
  docker compose run --rm --no-deps -T --entrypoint node fenix-api "/opt/fenix/$script" "$@"
}

check_key() {
  # $1 = kind, $2 = key; remaining args are key-check.mjs flags. Pipes the key
  # on stdin into the in-container check (the ONE validation implementation)
  # and prints "ok" plus any scopes/warning lines, or "rejected: <reason>".
  kind="$1"
  keyval="$2"
  shift 2
  rc=0
  line=$(printf '%s' "$keyval" | in_container_node scripts/key-check.mjs "$kind" "$@") || rc=$?
  if [ "$rc" = "2" ]; then
    printf 'rejected: key check usage error (see stderr)\n'
    return 1
  fi
  okv=$(printf '%s' "$line" | sed -n 's/.*"ok"[[:space:]]*:[[:space:]]*\([a-z]*\).*/\1/p')
  if [ "$okv" = "true" ]; then
    printf 'ok\n'
    scopes=$(printf '%s' "$line" | sed -n 's/.*"scopes"[[:space:]]*:[[:space:]]*\[\([^]]*\)\].*/\1/p' | sed 's/","/", /g')
    if [ -n "$scopes" ]; then
      printf 'Scopes: %s\n' "$scopes"
    fi
    warn=$(printf '%s' "$line" | sed -n 's/.*"warning"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p')
    if [ -n "$warn" ]; then
      printf 'WARN %s\n' "$warn"
    fi
    return 0
  fi
  reason=$(printf '%s' "$line" | sed -n 's/.*"reason"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p')
  printf 'rejected: %s\n' "${reason:-unknown}"
  return 1
}

get_one_key() {
  # $1 = display name, $2 = kind, $3 = target file, $4.. key-check flags.
  # Max 3 tries, then exit 5.
  name="$1"
  kind="$2"
  target="$3"
  shift 3

  if [ -f "$target" ] && [ -s "$target" ]; then
    printf '%s already exists (%s).\nOverwrite? [y/N] ' "$name" "$target"
    ans=""
    IFS= read -r ans || true
    case "$ans" in
      y|Y|yes|Yes|YES) ;;
      *)
        if [ "${VALIDATE_STORED:-0}" != "1" ]; then
          printf 'Keeping the existing %s.\n' "$name"
          return 0
        fi
        # The stored key must still work for the CURRENT candidate (the flags
        # name the provider/endpoint) — not for whatever it was saved for.
        storedkey=$(cat "$target" 2>/dev/null) || storedkey=""
        out=$(check_key "$kind" "$storedkey" "$@") || true
        case "$out" in
          ok*)
            printf '%s\n' "$out"
            printf 'OK  the stored %s works for this choice.\n' "$name"
            return 0
            ;;
          *)
            printf 'FAIL the stored %s does not work with this choice: %s\n' "$name" "$out"
            printf 'Enter a new key (Ctrl-C cancels).\n'
            ;;
        esac
        ;;
    esac
  fi

  tries=0
  while [ "$tries" -lt 3 ]; do
    tries=$((tries + 1))
    read_secret "Enter $name [try $tries/3]: "
    k="$REPLY_SECRET"
    if [ -z "$k" ]; then
      printf 'FAIL %s key empty — try again.\n' "$name"
      continue
    fi
    out=$(check_key "$kind" "$k" "$@") || true
    case "$out" in
      ok*)
        printf '%s\n' "$out"
        printf 'OK  %s key validated.\n' "$name"
        ;;
      *)
        printf 'FAIL %s key %s\n' "$name" "$out"
        continue
        ;;
    esac
    printf '%s' "$k" > "$target"
    chmod 600 "$target" 2>/dev/null || true
    unset k
    return 0
  done

  unset k
  printf 'Giving up on %s after 3 attempts.\n' "$name"
  exit 5
}

write_env_line() {
  # Replace (or append) the LINEAR_TEAM_KEY line in fenix.env, keeping other lines.
  line="$1"
  tmp="$ENV_FILE.tmp"
  if [ -f "$ENV_FILE" ]; then
    awk -v new="$line" '
      /^LINEAR_TEAM_KEY=/ { if (!done) { print new; done = 1 } next }
      { print }
      END { if (!done) print new }
    ' "$ENV_FILE" > "$tmp"
    mv "$tmp" "$ENV_FILE"
  else
    printf '%s\n' "$line" > "$ENV_FILE"
  fi
}

esc_json() {
  # Escape a string for embedding inside a printf-built JSON literal.
  printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g'
}

settings_get() {
  # $1 = dotted path; prints the string value or nothing. The overlay lives at
  # /fenix-config/settings.json in Docker (= host .fenix/config/settings.json).
  in_container_node scripts/fenix-settings.mjs get "$1" 2>/dev/null || true
}

settings_set() {
  # $1 = dotted path, $2 = JSON-encoded value; exits non-zero on rejection.
  in_container_node scripts/fenix-settings.mjs set "$1" "$2"
}

commit_provider() {
  # Validate the complete overlay before asking for or replacing any key.
  provider_target="$1"
  provider_patch="$2"
  shift 2
  in_container_node scripts/fenix-settings.mjs validate provider "$provider_patch"
  provider_had_secret=0
  provider_old_secret=""
  if [ -f "$provider_target" ]; then
    provider_had_secret=1
    provider_old_secret=$(cat "$provider_target")
  fi
  provider_display="$1"
  shift
  get_one_key "$provider_display" provider "$provider_target" "$@"
  if ! settings_set provider "$provider_patch"; then
    if [ "$provider_had_secret" = "1" ]; then
      printf '%s' "$provider_old_secret" > "$provider_target"
      chmod 600 "$provider_target" 2>/dev/null || true
    else
      rm -f -- "$provider_target"
    fi
    unset provider_old_secret
    printf 'FAIL settings were not saved; the previous provider key was restored.\n' >&2
    exit 1
  fi
  unset provider_old_secret
}

provider_wizard() {
  # Choose the provider (configured ones + custom) and store the matching
  # key: OpenRouter keeps its own secret file, every other provider uses the
  # shared provider_api_key. The choice is STAGED in memory and the overlay
  # (provider.active, provider.custom) is written only AFTER the key passed
  # its live check against the candidate — a failed or cancelled wizard
  # leaves the previous settings and secrets untouched.
  active=$(settings_get provider.active)
  active="${active:-openrouter}"
  list=$(in_container_node scripts/provider-resolve.mjs --list)
  printf 'Available providers:\n%s\n  custom          — your own Anthropic-compatible endpoint\n' "$list"

  provider=""
  while :; do
    printf 'Provider [%s]: ' "$active"
    IFS= read -r provider || true
    if [ -z "$provider" ]; then
      provider="$active"
    fi
    if [ "$provider" = "custom" ]; then
      break
    fi
    if printf '%s\n' "$list" | awk -v p="$provider" 'found { next } $1 == p { found = 1 } END { exit !found }'; then
      break
    fi
    printf 'Unknown provider: %s\n' "$provider"
    provider=""
  done

  # The stored key, when kept, must prove itself against the just-chosen
  # provider — not against whatever it was saved for before.
  VALIDATE_STORED=1
  case "$provider" in
    custom)
      baseurl=""
      while :; do
        printf 'Base URL (e.g. https://llm.internal.example/api): '
        IFS= read -r baseurl || true
        if [ -n "$baseurl" ]; then break; fi
        printf 'Base URL must not be empty.\n'
      done
      authstyle=""
      while :; do
        printf 'Auth style, token (Authorization: Bearer) or apikey (x-api-key) [token]: '
        IFS= read -r authstyle || true
        authstyle="${authstyle:-token}"
        case "$authstyle" in
          token|apikey) break ;;
          *) printf 'Use "token" or "apikey".\n' ;;
        esac
      done
      model=""
      while :; do
        printf 'Default model: '
        IFS= read -r model || true
        if [ -n "$model" ]; then break; fi
        printf 'Default model must not be empty.\n'
      done
      json=$(printf '{"active":"custom","custom":{"baseUrl":"%s","authStyle":"%s","keyName":"PROVIDER_API_KEY","tiers":{},"defaultModel":"%s"}}' \
        "$(esc_json "$baseurl")" "$authstyle" "$(esc_json "$model")")
      commit_provider "$SECRET_DIR/provider_api_key" "$json" "Custom provider API key" \
        --base-url "$baseurl" --auth-style "$authstyle" --model "$model"
      ;;
    openrouter)
      commit_provider "$SECRET_DIR/openrouter_api_key" '{"active":"openrouter"}' "OpenRouter API key" --provider openrouter
      ;;
    *)
      json=$(printf '{"active":"%s"}' "$(esc_json "$provider")")
      commit_provider "$SECRET_DIR/provider_api_key" "$json" "$provider API key" --provider "$provider"
      ;;
  esac
  unset VALIDATE_STORED
}

team_key_step() {
  # The Linear team key (fenix.env LINEAR_TEAM_KEY) is validated against the
  # stored Linear key with the same in-container check.
  lkey=$(cat "$SECRET_DIR/linear_api_key" 2>/dev/null) || lkey=""
  team=""
  while :; do
    printf 'Enter the Linear team key (e.g. FOC): '
    if ! IFS= read -r team; then
      printf '\nNo input — aborting.\n'
      exit 1
    fi
    if [ -z "$team" ]; then
      printf 'Team key must not be empty.\n'
      continue
    fi
    out=$(check_key linear "$lkey" --team "$team") || true
    case "$out" in
      ok)
        break
        ;;
      *)
        printf 'FAIL %s\n' "$out"
        ;;
    esac
  done
  write_env_line "LINEAR_TEAM_KEY=$team"
}

key_wizard() {
  ensure_secret_files
  trap restore_tty EXIT
  trap 'restore_tty; exit 130' INT
  trap 'restore_tty; exit 143' TERM

  provider_wizard
  get_one_key "Linear API key" linear "$SECRET_DIR/linear_api_key"
  get_one_key "GitHub token" github "$SECRET_DIR/github_token"
  team_key_step

  unset k REPLY_SECRET team ans lkey
  printf 'Keys saved in %s; config in %s.\n' "$SECRET_DIR" "$ENV_FILE"
}

retention_step() {
  # First-run retention question, asked once in the same flow as the key
  # wizard (fenix up). Keep-all is the default and this step NEVER deletes
  # anything — it only records the policy in the settings overlay; the actual
  # apply/prune lives in `fenix retention` and the node CLI.
  case "${FENIX_NONINTERACTIVE:-}" in
    1|[Tt]|[Tt][Rr][Uu][Ee]|[Yy]|[Yy][Ee][Ss]) return 0 ;;
  esac
  if [ ! -t 0 ]; then
    # No TTY (CI, piped stdin): skip silently, keep-all stays the default.
    return 0
  fi
  # `get retention` prints the stored value; an unset key reports as empty,
  # `null` or an error — all three mean "not answered yet".
  current=$(settings_get retention) || true
  case "$(printf '%s' "$current" | tr -d '[:space:]')" in
    ""|null|undefined) ;;
    *) return 0 ;;
  esac

  printf 'Keep all logs and transcripts? [Y/n] '
  ans=""
  IFS= read -r ans || true
  case "$ans" in
    n|N|no|No|NO)
      while :; do
        printf 'Keep logs for how many days? [90] '
        days=""
        IFS= read -r days || true
        days="${days:-90}"
        case "$days" in
          *[!0-9]*)
            printf 'Enter a whole number of days (1..36500).\n'
            continue
            ;;
        esac
        # Strip leading zeros so the written JSON stays valid (07 is not).
        days=$(printf '%s' "$days" | sed 's/^0*//')
        [ -n "$days" ] || days=0
        if [ "$days" -lt 1 ] || [ "$days" -gt 36500 ]; then
          printf 'Enter a whole number of days (1..36500).\n'
          continue
        fi
        break
      done
      if settings_set retention "{\"keepDays\": $days}"; then
        printf 'OK  logs older than %s days can be pruned with `fenix retention prune`.\n' "$days"
      else
        printf 'WARN retention was not saved — the keep-all default stays.\n'
      fi
      ;;
    *)
      # Default Y: record keep-all explicitly so the question is not asked
      # again on the next `fenix up`.
      if settings_set retention '{"keepDays": null, "minFreeGiB": 5}'; then
        printf 'OK  keeping all logs and transcripts (nothing is pruned).\n'
      else
        printf 'WARN retention was not saved — the keep-all default stays.\n'
      fi
      ;;
  esac
}

rotate_key() {
  # fenix keys <name> — rotate one key without re-running the whole wizard.
  name="$1"
  ensure_secret_files
  trap restore_tty EXIT
  trap 'restore_tty; exit 130' INT
  trap 'restore_tty; exit 143' TERM
  case "$name" in
    openrouter)
      get_one_key "OpenRouter API key" provider "$SECRET_DIR/openrouter_api_key" --provider openrouter
      ;;
    provider)
      active=$(settings_get provider.active)
      active="${active:-openrouter}"
      case "$active" in
        openrouter)
          get_one_key "OpenRouter API key" provider "$SECRET_DIR/openrouter_api_key" --provider openrouter
          ;;
        custom)
          get_one_key "Custom provider API key" provider "$SECRET_DIR/provider_api_key" --provider custom
          ;;
        *)
          get_one_key "$active API key" provider "$SECRET_DIR/provider_api_key" --provider "$active"
          ;;
      esac
      ;;
    linear)
      get_one_key "Linear API key" linear "$SECRET_DIR/linear_api_key"
      ;;
    github)
      get_one_key "GitHub token" github "$SECRET_DIR/github_token"
      ;;
    *)
      printf 'usage: fenix keys [openrouter|provider|linear|github]\n' >&2
      exit 2
      ;;
  esac
  unset k REPLY_SECRET ans
}

keys_ok() {
  for f in "$SECRET_DIR/openrouter_api_key" "$SECRET_DIR/linear_api_key" "$SECRET_DIR/github_token"; do
    if [ ! -s "$f" ]; then
      return 1
    fi
  done
  return 0
}

# Every Compose secret file must exist or `docker compose up` fails on the
# missing file mount (FOC-786). Create missing ones empty, owner-only —
# provider_api_key is optional (an empty file just means unauthenticated), and
# keys_ok above keeps requiring only the three required keys.
ensure_secret_files() {
  mkdir -p "$SECRET_DIR"
  chmod 700 "$SECRET_DIR" 2>/dev/null || true
  umask 077
  for f in openrouter_api_key linear_api_key github_token provider_api_key; do
    if [ ! -e "$SECRET_DIR/$f" ]; then
      : > "$SECRET_DIR/$f"
      chmod 600 "$SECRET_DIR/$f" 2>/dev/null || true
    fi
  done
}

# --- commands ----------------------------------------------------------------

wait_healthy() {
  waited=0
  while [ "$waited" -lt 180 ]; do
    cid=$(docker compose ps -q fenix-api 2>/dev/null) || cid=""
    if [ -n "$cid" ]; then
      st=$(docker inspect --format '{{.State.Health.Status}}' "$cid" 2>/dev/null) || st=""
      if [ "$st" = "healthy" ]; then
        return 0
      fi
    fi
    sleep 3
    waited=$((waited + 3))
  done
  return 1
}

cmd_up() {
  preflight strict

  # The project map lives in a host dir mounted at /fenix-config; create it
  # first so Docker does not create it root-owned. This must precede every
  # compose invocation below — including the key wizard and the retention
  # step, which go through `docker compose run` (FOC-780).
  mkdir -p .fenix/config
  # Compose mounts every secret file — missing ones must exist (empty).
  ensure_secret_files

  if ! keys_ok; then
    printf 'Some keys are missing or empty — running the key wizard.\n'
    key_wizard
  fi

  retention_step

  printf 'Building and starting the stack...\n'
  docker compose up -d --build

  if ! wait_healthy; then
    printf 'FAIL fenix-api health — not healthy after 180 s — fix: fenix logs fenix-api\n'
    exit 4
  fi

  printf 'Fenix is up: http://localhost:%s\n' "$PORT"
  url="http://localhost:$PORT"
  if command -v xdg-open >/dev/null 2>&1; then
    xdg-open "$url" >/dev/null 2>&1 || true
  elif command -v open >/dev/null 2>&1; then
    open "$url" >/dev/null 2>&1 || true
  elif command -v cmd.exe >/dev/null 2>&1; then
    cmd.exe /c start "" "$url" >/dev/null 2>&1 || true
  fi
}

cmd_doctor() {
  rc=0
  if ! preflight full; then
    rc=1
  fi
  cid=$(docker compose ps -q fenix-api 2>/dev/null) || cid=""
  if [ -n "$cid" ]; then
    if ! docker compose exec -T fenix-api "$ENTRYPOINT" doctor; then
      rc=1
    fi
  else
    printf 'WARN fenix-api not running — run: fenix up\n'
  fi
  exit "$rc"
}

cmd_test() {
  # Docker on Windows needs a Windows path for the bind mount; Git Bash gives
  # one with pwd -W (path conversion is off for this script).
  src=$(pwd -W 2>/dev/null || pwd)
  if ! docker image inspect fenix:dev >/dev/null 2>&1; then
    printf 'Building the image first...\n'
    docker compose build
  fi
  exec docker run --rm -v "$src:/src:ro" fenix:dev sh /src/docker/test-in-container.sh "$@"
}

# --- dispatch ----------------------------------------------------------------

cmd="${1:-}"
if [ $# -gt 0 ]; then
  shift
fi

case "$cmd" in
  ""|help|-h|--help)
    usage
    exit 0
    ;;
  up)
    cmd_up
    ;;
  stop)
    exec docker compose stop
    ;;
  down)
    printf 'Stopping and removing containers (the data volume is kept).\n'
    exec docker compose down
    ;;
  logs)
    if [ $# -ge 1 ]; then
      exec docker compose logs -f --tail 200 "$1"
    else
      exec docker compose logs -f --tail 200
    fi
    ;;
  keys)
    if [ $# -ge 1 ]; then
      rotate_key "$1"
    else
      key_wizard
    fi
    ;;
  doctor)
    cmd_doctor
    ;;
  retention)
    # Forward to the retention CLI in the container (the same in-container
    # node pattern as the settings wizard). The node script owns usage errors
    # (exit 2) and a refused prune (exit 1); the exit code passes through.
    if [ $# -ge 1 ]; then
      verb="$1"
      shift
    else
      verb="show"
    fi
    in_container_node scripts/fenix-retention.mjs "$verb" "$@"
    ;;
  attach)
    exec docker compose exec fenix-supervisor "$ENTRYPOINT" attach "$@"
    ;;
  shell)
    svc="${1:-fenix-supervisor}"
    exec docker compose exec "$svc" "$ENTRYPOINT" shell
    ;;
  update)
    git pull --ff-only
    docker compose build --pull
    exec docker compose up -d
    ;;
  repo)
    sub="${1:-}"
    if [ $# -gt 0 ]; then shift; fi
    case "$sub" in
      add)
        if [ $# -lt 1 ]; then
          printf 'usage: fenix repo add <url|owner/name> [--project <Linear project>]\n' >&2
          exit 2
        fi
        exec docker compose exec -T fenix-supervisor "$ENTRYPOINT" repo-add "$@"
        ;;
      list)
        exec docker compose exec -T fenix-supervisor "$ENTRYPOINT" repo-list
        ;;
      *)
        printf 'usage: fenix repo add <url|owner/name> [--project <Linear project>] | fenix repo list\n' >&2
        exit 2
        ;;
    esac
    ;;
  test)
    cmd_test "$@"
    ;;
  *)
    printf 'Unknown command: %s\n\n' "$cmd" >&2
    usage >&2
    exit 2
    ;;
esac
