# secrets & local config
.env
.env.local
agents/*/settings.local.json
**/credentials.json
**/*.secret

# runtime I/O (keep folders, ignore content)
.state/
planning/inbox/*
!planning/inbox/sample.md
planning/briefs/*
!planning/**/.gitkeep

# claude code per-agent runtime state (sessions/history/cache live in CLAUDE_CONFIG_DIR)
agents/*/projects/
agents/*/sessions/
agents/*/session-env/
agents/*/telemetry/
agents/*/logs/
agents/*/paste-cache/
agents/*/.credentials.json
agents/*/mcp-needs-auth-cache.json
agents/*/*.local.json
agents/*/.claude.json
agents/*/.last-cleanup
agents/*/backups/
agents/*/file-history/
agents/*/shell-snapshots/
agents/*/tasks/
agents/*/cache/
agents/*/history.jsonl
agents/*/plugins/
agents/*/plans/
agents/*/todos/
agents/*/.last-update-result.json
agents/*/jobs/
agents/*/daemon/

# spike scratch (re-runnable T-A1 evidence; see docs/adr/0002)
.spike-*/

# throwaway test scripts (kept locally for re-verification, not committed)
scripts/_test_*.mjs

# freetext scratch (prompt-engineering working notes — not docs)
docs/99_freetext/

# agent bridge scratch (Pro review reports, worker io)
.agent-io/

# node / ui
node_modules/
ui/node_modules/
ui/.next/
dist/
build/

# python (notebooks/)
__pycache__/
*.pyc
.venv/

# generated analysis report — same reasoning as graphify-out/ below, but 17 MB:
# data.json (9.4 MB) and index.html (7.5 MB) are regenerated output, and the
# .pkl files are caches. Rebuild with notebooks/agent_intelligence.py.
report/

# knowledge graph — regenerated locally by the post-commit hook (AST only, no LLM),
# so committing it would churn ~700 nodes of JSON on every commit. The corpus
# scope lives in .graphifyignore, which IS tracked.
graphify-out/

# os / editor
.DS_Store
Thumbs.db
*.log

.env.backup-fen

# Rendered at launcher startup from config/atlas-mcp.json.template by bin/_lib.bat
config/atlas-mcp.json

# CodeGraph local index — rebuildable with `codegraph init`, and large.
.codegraph/

# Nebul diagnostics: raw HTTP wire captures, ~25 MB. The repro scripts and the
# support report next to them are committed; the dumps they produce are not.
# They are regenerable by re-running the probes, and being raw request/response
# bodies they are exactly the kind of artefact that can pick up a credential.
tools/nebul/*.bin
tools/nebul/nebul-fail-*.json
tools/nebul/claude-wire-*.json
tools/nebul/nebul_replica_hunt.json
tools/nebul/nebul_sat_run1.json
tools/nebul/NEBUL_*_LOG.txt

# Installed supervisor skills. Third-party projects with their own release
# cycles, ~25 MB, and diagram-design is a git CLONE — `git add` on it records
# a bare gitlink with no .gitmodules, which hands anyone who clones this repo
# an empty directory. The skills committed under agents/orchestrator/skills/
# are a different thing: one SKILL.md each, written here.
# To version these properly: submodule for diagram-design, vendor archify.
agents/supervisor/skills/
