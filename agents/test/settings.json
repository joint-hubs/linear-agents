{
  "permissions": {
    "allow": [
      "Read",
      "Grep",
      "Glob",
      "Write",
      "Bash(node:*)",
      "Bash(graphify query:*)",
      "Bash(graphify affected:*)",
      "Bash(graphify god-nodes:*)",
      "Bash(graphify path:*)",
      "Bash(graphify explain:*)",
      "Bash(docker:*)",
      "Bash(docker compose:*)",
      "Bash(gcloud:*)",
      "Bash(ssh:*)",
      "Bash(scp:*)",
      "Bash(curl:*)",
      "Bash(npx playwright:*)",
      "Bash(k6:*)",
      "Bash(make:*)",
      "Bash(npm run:*)",
      "mcp__linear__*",
      "mcp__codegraph__*",
      "Bash(codegraph:*)"
    ],
    "deny": [
      "Bash(rm -rf:*)",
      "Bash(git push:*)",
      "Artifact",
      "PushNotification",
      "ListAgents",
      "Monitor"
    ],
    "defaultMode": "default"
  },
  "theme": "dark",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$LA_ROOT/scripts/telemetry-hook.mjs\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
