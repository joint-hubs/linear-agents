{
  "permissions": {
    "defaultMode": "default",
    "allow": [
      "Read", "Grep", "Glob", "Write",
      "Bash(node:*)",
      "Bash(git status:*)", "Bash(git diff:*)", "Bash(git log:*)", "Bash(git show:*)", "Bash(git worktree:*)"
    ],
    "deny": [
      "mcp__linear__*"
    ]
  },
  "theme": "dark",
  "hooks": {
    "SessionStart": [{
      "hooks": [{ "type": "command", "command": "node \"$LA_ROOT/scripts/telemetry-hook.mjs\"", "timeout": 5 }]
    }]
  }
}
