{
  "permissions": {
    "allow": [
      "Read",
      "Grep",
      "Glob",
      "Write",
      "Bash(node:*)",
      "Bash(node *linear-ops.mjs*)",
      "Bash(node *publish-linear-comment.mjs*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git branch:*)",
      "Bash(git fetch:*)",
      "Bash(git rev-list:*)",
      "Bash(git merge-base:*)",
      "Bash(git cherry:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git worktree:*)",
      "mcp__codegraph__*",
      "Bash(codegraph:*)"
    ],
    "deny": [
      "mcp__linear__*",
      "Artifact",
      "PushNotification",
      "ListAgents",
      "Monitor"
    ],
    "defaultMode": "default"
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$LA_ROOT/scripts/telemetry-hook.mjs\"",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "theme": "dark",
  "tui": "fullscreen"
}
