{
  "permissions": {
    "allow": [
      "mcp__codegraph__*",
      "mcp__fenix-decision-extraction__*",
      "mcp__fenix-decision-prompt-refinement__*",
      "Bash(node $LA_ROOT/scripts/supervisor-status.mjs:*)",
      "Bash(node \"$LA_ROOT/scripts/supervisor-status.mjs\":*)",
      "Bash(npm ci:*)",
      "Bash(node scripts/test-all.mjs:*)",
      "Bash(env -u LA_SUPERVISOR_CHILD node scripts/test-all.mjs:*)",
      "Bash(node scripts/graph-runner.mjs:*)",
      "Bash(LA_RUN_ID=* node scripts/graph-runner.mjs *)"
    ]
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "codegraph prompt-hook"
          }
        ]
      }
    ]
  }
}
