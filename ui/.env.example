# Copy to .env (gitignored) and adjust to your setup.
# Vite exposes only vars prefixed with VITE_ to the client.

# Linear workspace slugs. These appear in issue URLs the UI renders
# (e.g. https://linear.app/<workspace>/issue/<ID>). Override when forking
# the project for a different Linear organization. Defaults match the
# original project (pisi + jointhubs).
VITE_LINEAR_WORKSPACE_PISI=pisi
VITE_LINEAR_WORKSPACE_JOINTHUBS=jointhubs
