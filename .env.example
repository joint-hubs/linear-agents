# Copy to .env (gitignored) and fill. Loaded by bin/_lib.bat.

# --- Providers (Anthropic-compatible endpoints) ---
# A provider's API key is stored in this file at the env-var NAME given by `authEnv`
# in config/models.json::providers. Only the secret VALUE belongs here (gitignored);
# provider definitions (baseUrl, authStyle) stay in models.json. Default provider =
# `openrouter`, so OPENROUTER_API_KEY is required.
OPENROUTER_API_KEY=sk-or-v1-________________________
ANTHROPIC_API_KEY=sk-ant-________________________   # for native Anthropic (Opus/Sonnet) path
# Optional provider keys — uncomment + fill when a squad's LA_PROVIDER points to a
# profile whose authEnv matches one of these names (see config/models.json::providers):
#ZAI_API_KEY=
#MINIMAX_API_KEY=
#DEEPSEEK_API_KEY=
#MOONSHOT_API_KEY=

# --- Linear ---
LINEAR_API_KEY=lin_api_________________________
LINEAR_API_KEY_PISI=lin_api_________________________  # PISI workspace key — used when LINEAR_WORKSPACE=pisi (full-write, per Mateusz 2026-07)
LINEAR_TEAM_KEY=               # e.g. JOI / PISI  (TODO: confirm workspace/team)
LINEAR_AGENT_OAUTH_TOKEN=      # bot @flow (OAuth actor=app) for webhooks (TODO)

# --- Local filesystem ---
GITHUB_ROOT=                   # path to your projects root, e.g. ~/Documents/GitHub (used to expand config/projects.json)
ATLAS_ROOT=                    # path to the Atlas repo (sibling of linear-agents), e.g. ~/Documents/GitHub/atlas
ATLAS_VENV_PYTHON=             # absolute path to Atlas's Python venv interpreter, e.g. C:\Users\you\atlas\.venv\Scripts\python.exe

# --- Deploy targets (TEST agent) ---
GCP_PROJECT=
GCP_ZONE=
GCP_VM_NAME=                   # OpenRouter build deploy target (TODO)
LAMBDA_API_KEY=                # Ollama/GPU build path (TODO)
LAMBDA_INSTANCE=

# --- Linear project identifiers (used by config/projects.json) ---
LINEAR_TEAM_KEY_FEN=FEN
LINEAR_PROJECT_ID_FEN=
LINEAR_TEAM_UUID_FEN=

# --- Guardrails ---
COST_BUDGET_USD_PER_TASK=2.00  # kill-switch threshold (W6)
